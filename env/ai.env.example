# Merge into ai-service/.env; do not replace existing provider/catalog settings.
# URL-encode the server password. Python process is local, database is tunneled.
AI_DATABASE_URL=postgresql+psycopg://postgres:replace-with-server-password@127.0.0.1:5433/ai_db
AI_BACKEND_API_URL=http://localhost:8082
AI_JWT_JWKS_URL=http://localhost:8081/.well-known/jwks.json
AI_JWT_ISSUER=http://identity-service
AI_JWT_AUDIENCE=pc-shopping-api
AI_OTLP_ENDPOINT=http://127.0.0.1:4318
# Integration tests must use a disposable database, not a shared server ai_db.
# Do not copy a production/shared URL into AI_TEST_POSTGRES_DSN.
