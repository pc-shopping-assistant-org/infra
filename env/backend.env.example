# Import into the IDE/process environment. Spring Boot does not load .env itself.
# This example uses an SSH tunnel to server infrastructure.
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5433
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=replace-with-server-password
SPRING_DATA_REDIS_HOST=127.0.0.1
SPRING_DATA_REDIS_PORT=6379
SPRING_DATA_REDIS_PASSWORD=replace-with-server-password
SPRING_RABBITMQ_HOST=127.0.0.1
SPRING_RABBITMQ_PORT=5672
SPRING_RABBITMQ_USERNAME=pcshop
SPRING_RABBITMQ_PASSWORD=replace-with-server-password
SPRING_KAFKA_BOOTSTRAP_SERVERS=127.0.0.1:29092
SPRING_KAFKA_PROPERTIES_SECURITY_PROTOCOL=SASL_PLAINTEXT
SPRING_KAFKA_PROPERTIES_SASL_MECHANISM=PLAIN
SPRING_KAFKA_PROPERTIES_SASL_JAAS_CONFIG='org.apache.kafka.common.security.plain.PlainLoginModule required username="pcshop" password="replace-with-server-password";'
SPRING_ELASTICSEARCH_URIS=http://127.0.0.1:9200
SPRING_ELASTICSEARCH_USERNAME=elastic
SPRING_ELASTICSEARCH_PASSWORD=replace-with-server-password
OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318
EUREKA_CLIENT_SERVICEURL_DEFAULTZONE=http://localhost:8761/eureka/
JWT_JWKS_URI=http://localhost:8081/.well-known/jwks.json
JWT_SECURITY_ISSUER=http://identity-service
AI_SERVICE_URL=http://localhost:8000
# Keep existing application-specific SMTP/Cloudinary/payment settings in local env.
