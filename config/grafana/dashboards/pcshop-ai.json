{
  "uid": "pcshop-ai",
  "title": "PC Shopping - AI Runs",
  "tags": ["pcshop", "ai"],
  "schemaVersion": 39,
  "version": 3,
  "editable": true,
  "time": {"from": "now-30m", "to": "now"},
  "refresh": "10s",
  "templating": {
    "list": [
      {
        "name": "trace_id",
        "label": "Trace ID",
        "type": "textbox",
        "query": ".*",
        "current": {"text": ".*", "value": ".*"}
      },
      {
        "name": "level",
        "label": "Level",
        "type": "custom",
        "query": "error,warn,info,debug",
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "current": {"text": "All", "value": "$__all"}
      },
      {
        "name": "search",
        "label": "Search",
        "type": "textbox",
        "query": "",
        "current": {"text": "", "value": ""}
      }
    ]
  },
  "panels": [
    {
      "id": 3,
      "type": "timeseries",
      "title": "AI Step Rate by Outcome (req/s)",
      "gridPos": {"x": 0, "y": 0, "w": 12, "h": 7},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{
        "refId": "A",
        "expr": "sum by (ai_step, ai_outcome) (rate(ai_step_total[5m]))",
        "legendFormat": "{{ai_step}} ({{ai_outcome}})"
      }]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "AI Step p95 Latency (ms)",
      "gridPos": {"x": 12, "y": 0, "w": 12, "h": 7},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{
        "refId": "A",
        "expr": "histogram_quantile(0.95, sum by (le, ai_step) (rate(ai_step_duration_ms_bucket[5m])))",
        "legendFormat": "{{ai_step}} p95"
      }],
      "fieldConfig": {
        "defaults": {"unit": "ms"}
      }
    },
    {
      "id": 6,
      "type": "table",
      "title": "Recent Errors Only (AI Service)",
      "description": "Filtered view of FAILED steps and unhandled exceptions for instant debugging.",
      "gridPos": {"x": 0, "y": 7, "w": 24, "h": 6},
      "datasource": {"type": "loki", "uid": "loki"},
      "targets": [{
        "refId": "A",
        "expr": "{service_name=\"ai-service\"} | (detected_level=~\"error|fatal\" or outcome=\"FAILED\") | trace_id=~\"${trace_id:raw}\" |~ \"(?i)${search:raw}\"",
        "queryType": "range"
      }],
      "transformations": [
        {
          "id": "extractFields",
          "options": {"source": "labels", "format": "auto", "replace": false}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Line": true, "id": true, "labels": true, "tsNs": true,
              "service_name": true, "detected_level": true, "severity_text": true,
              "severity_number": true, "scope_name": true, "observed_timestamp": true,
              "event": true, "span_id": true, "run_id": true, "conversation_id": true,
              "execution_id": true, "generation": true, "code_filepath": true,
              "code_function": true, "code_lineno": true, "outcome": true
            },
            "indexByName": {
              "Time": 0, "step": 1, "error_type": 2, "error_location": 3,
              "duration_ms": 4, "trace_id": 5
            },
            "renameByName": {
              "step": "Step", "error_type": "Error", "error_location": "Location",
              "duration_ms": "Duration (ms)", "trace_id": "Trace ID"
            }
          }
        }
      ],
      "options": {"showHeader": true, "sortBy": [{"displayName": "Time", "desc": true}]}
    },
    {
      "id": 5,
      "type": "table",
      "title": "AI Step Summary (noise-free table view)",
      "description": "Completed/failed steps formatted as a table (excludes 202 polling noise). Click a trace_id to open its Tempo waterfall.",
      "gridPos": {"x": 0, "y": 13, "w": 24, "h": 11},
      "datasource": {"type": "loki", "uid": "loki"},
      "targets": [{
        "refId": "A",
        "expr": "{service_name=\"ai-service\"} | event=~\"step.finished|http.request.finished|http.unhandled_exception\" !~ \"/runs/.*/result status=202\" | trace_id=~\"${trace_id:raw}\" | detected_level=~\"$level\" |~ \"(?i)${search:raw}\"",
        "queryType": "range"
      }],
      "transformations": [
        {
          "id": "extractFields",
          "options": {
            "source": "labels",
            "format": "auto",
            "replace": false
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Line": true,
              "id": true,
              "labels": true,
              "tsNs": true,
              "service_name": true,
              "detected_level": true,
              "severity_text": true,
              "severity_number": true,
              "scope_name": true,
              "observed_timestamp": true,
              "event": true,
              "span_id": true,
              "run_id": true,
              "conversation_id": true,
              "execution_id": true,
              "generation": true,
              "code_filepath": true,
              "code_function": true,
              "code_lineno": true
            },
            "indexByName": {
              "Time": 0,
              "step": 1,
              "outcome": 2,
              "duration_ms": 3,
              "result_status": 4,
              "error_type": 5,
              "error_location": 6,
              "trace_id": 7
            },
            "renameByName": {
              "step": "Step",
              "outcome": "Outcome",
              "duration_ms": "Duration (ms)",
              "result_status": "Status",
              "error_type": "Error",
              "error_location": "Location",
              "trace_id": "Trace ID"
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {"align": "auto", "filterable": true}
        },
        "overrides": [
          {
            "matcher": {"id": "byName", "options": "Outcome"},
            "properties": [
              {"id": "custom.cellOptions", "value": {"type": "color-background", "mode": "basic"}},
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "SUCCEEDED": {"color": "green", "text": "SUCCEEDED"},
                      "FAILED": {"color": "red", "text": "FAILED"},
                      "CANCELLED": {"color": "orange", "text": "CANCELLED"}
                    }
                  }
                ]
              }
            ]
          },
          {
            "matcher": {"id": "byName", "options": "Duration (ms)"},
            "properties": [
              {"id": "unit", "value": "ms"},
              {"id": "custom.width", "value": 120}
            ]
          },
          {
            "matcher": {"id": "byName", "options": "Trace ID"},
            "properties": [
              {
                "id": "links",
                "value": [
                  {
                    "title": "Open in Tempo",
                    "url": "/explore?left=%7B%22datasource%22:%22tempo%22,%22queries%22:%5B%7B%22queryType%22:%22traceql%22,%22query%22:%22${__value.raw}%22%7D%5D%7D",
                    "targetBlank": true
                  }
                ]
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "sortBy": [{"displayName": "Time", "desc": true}]
      }
    },
    {
      "id": 1,
      "type": "logs",
      "title": "Detailed Logs (noise-filtered, 1-line format)",
      "description": "Excludes noisy step.started and 202 /result polling. Click any line to expand full metadata.",
      "gridPos": {"x": 0, "y": 24, "w": 24, "h": 12},
      "datasource": {"type": "loki", "uid": "loki"},
      "targets": [{
        "refId": "A",
        "expr": "{service_name=\"ai-service\"} | event!=\"step.started\" !~ \"/runs/.*/result status=202\" | trace_id=~\"${trace_id:raw}\" | detected_level=~\"$level\" |~ \"(?i)${search:raw}\" | line_format \"{{if .trace_id}}[{{printf \\\"%.8s\\\" .trace_id}}] {{end}}{{if .step}}[{{.step}}] {{end}}{{if .outcome}}{{.outcome}} {{end}}{{if .duration_ms}}({{.duration_ms}}ms) {{end}}{{if .error_type}}ERR={{.error_type}}{{if .error_location}} @{{.error_location}}{{end}} — {{end}}{{__line__}}\"",
        "queryType": "range"
      }],
      "options": {
        "showTime": true,
        "showLabels": false,
        "showCommonLabels": false,
        "sortOrder": "Descending",
        "wrapLogMessage": true,
        "prettifyLogMessage": false,
        "enableLogDetails": true,
        "dedupStrategy": "none"
      }
    },
    {
      "id": 2,
      "type": "table",
      "title": "AI execution traces (open a trace for step waterfall)",
      "gridPos": {"x": 0, "y": 36, "w": 24, "h": 10},
      "datasource": {"type": "tempo", "uid": "tempo"},
      "targets": [{
        "refId": "A",
        "queryType": "traceql",
        "query": "{ resource.service.name = \"ai-service\" }",
        "limit": 20,
        "tableType": "traces"
      }]
    }
  ]
}
