# Copy this file to staging.env for local staging.
# staging.env is ignored and must not be committed.

POSTGRES_VERSION=18.3-alpine
POSTGRES_VOLUME_NAME=pc-shopping-assistant-staging-postgres-v2
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=ecm_db
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_POOL_MAX_SIZE=10
DB_POOL_MIN_IDLE=5

# Host backend uses these connection values. AI infrastructure is provisioned
# separately by the production compose stack when it is needed.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/ecm_db
