# Copy this file to prod.env and replace every secret before deployment.
# Do not commit prod.env.

POSTGRES_DB=pc_shopping
POSTGRES_USER=pc_shopping
POSTGRES_PASSWORD=change-me

# The AI service reads the AI_* variables below. DATABASE_URL is reserved for
# a future relational AI read model; Qdrant settings are consumed by semantic
# retrieval and the catalog indexer when that mode is enabled.
DATABASE_URL=postgresql://pc_shopping:change-me@postgres:5432/pc_shopping
# Set this to the deployed backend API root. The backend service is not in
# this repository's current compose stack.
AI_BACKEND_API_URL=http://backend.example.internal/api/v1
AI_REQUEST_TIMEOUT_SECONDS=5
AI_CONVERSATION_MAX_MESSAGES=20
AI_RETRIEVAL_BACKEND=backend
AI_QDRANT_URL=http://qdrant:6333
AI_QDRANT_COLLECTION=products
AI_EMBEDDING_PROVIDER=http
# Required when AI_RETRIEVAL_BACKEND is `hybrid` or `qdrant` and provider is
# `http`; the provider contract should return one embedding vector per input.
# AI_EMBEDDING_API_URL=
# AI_EMBEDDING_API_KEY=
AI_EMBEDDING_DIMENSION=384
# Keep fallback until a provider/model has passed the model-backed acceptance
# set. Set `openai` or `gemini` and inject the matching secret through the
# deployment secret store when ready.
AI_PROVIDER=fallback
# AI_MODEL_NAME=
# AI_OPENAI_MODEL_NAME=gpt-4o-mini
# AI_GEMINI_MODEL_NAME=gemini-2.5-flash
# AI_OPENAI_API_KEY=
# AI_GEMINI_API_KEY=
QDRANT_URL=http://qdrant:6333
LOG_LEVEL=INFO

# Bind the public-facing AI port to localhost by default; terminate TLS in a
# host-level reverse proxy. Set 0.0.0.0 only when exposing the port directly.
AI_SERVICE_BIND_ADDRESS=127.0.0.1
AI_SERVICE_PORT=8000

# AI service image published by CI to GitHub Container Registry.
AI_SERVICE_IMAGE=ghcr.io/pc-shopping-assistant-org/ai-service:latest
