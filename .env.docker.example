# Global runtime env. Never copy this file into an application image.
# Fill secrets on the server. Blank values deliberately fail Compose validation.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
REDIS_PASSWORD=
RABBITMQ_USER=pcshop
RABBITMQ_PASSWORD=
# Kafka external SASL/PLAIN username is pcshop. Use hex secrets to avoid JAAS escaping.
KAFKA_PASSWORD=
ELASTIC_PASSWORD=
GRAFANA_ADMIN_PASSWORD=

# Default transport: SSH tunnels. Do not publish plaintext ports to the Internet.
INFRA_BIND_ADDRESS=127.0.0.1
KAFKA_ADVERTISED_HOST=127.0.0.1
POSTGRES_PORT=5433
GRAFANA_PORT=3300
INFRA_NETWORK=pcshop-infra
KAFKA_RETENTION_HOURS=168

# Stable explicit names: preserve or migrate existing data before switching stacks.
POSTGRES_VOLUME_NAME=pcshop-infra-postgres
REDIS_VOLUME_NAME=pcshop-infra-redis
RABBITMQ_VOLUME_NAME=pcshop-infra-rabbitmq
KAFKA_VOLUME_NAME=pcshop-infra-kafka
ELASTICSEARCH_VOLUME_NAME=pcshop-infra-elasticsearch
LGTM_VOLUME_NAME=pcshop-infra-lgtm

# Only needed with profile apps; never build source on the server.
GHCR_OWNER=pc-shopping-assistant-org
# Infra CI records selected release/sha-* tags in .release.env after success.
BACKEND_IMAGE_TAG=release
AI_IMAGE_TAG=release
WEB_IMAGE_TAG=release
GATEWAY_PORT=8080
WEB_PORT=3000
BACKEND_API_URL=http://api-gateway:8080
AI_API_URL=http://ai-service:8000/api/v1
AI_BACKEND_API_URL=http://catalog-service:8082

# Persistent Base64 DER PKCS#8 private key + X.509 public key, not PEM markers.
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
JWT_KEY_ID=identity-key-1
JWT_ISSUER=http://identity-service

# Internal postgres:5432/ai_db, with URL-encoded password matching the infra.
AI_DATABASE_URL=
# Optional specification/option mapping only; category types come from catalog.
AI_HARDWARE_CATALOG_MAPPING=
AI_PROVIDER=openai
AI_OPENAI_API_KEY=
AI_GEMINI_API_KEY=
# AI_MODEL_NAME=
# AI_QWEN_BASE_URL=http://your-model-host:8001/v1
# AI_QWEN_MODEL_NAME=Qwen/Qwen3-8B
# AI_QWEN_API_KEY=

GOOGLE_CLIENT_ID=
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_RETURN_URL=https://gearpc.example.com/vi/payment/vnpay-return
